# Sao chep file nay thanh .env truoc khi chay npm run dev.
# .env khong duoc commit.

# Dang nhap Google. Client ID cua OAuth 2.0 Client (loai Web application) tao trong Google
# Cloud Console > APIs & Services > Credentials. Authorized JavaScript origin phai khop
# http://localhost:5173. Day la gia tri public (khong phai secret) - an toan khi nam trong
# FE build. Phai trung GOOGLE_CLIENT_ID ben task-connect-be/.env.
VITE_GOOGLE_CLIENT_ID=
