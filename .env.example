# Sao chep file nay thanh .env truoc khi chay npm run dev.
# .env khong duoc commit.

# Dang nhap Google. Client ID cua OAuth 2.0 Client (loai Web application) tao trong Google
# Cloud Console > APIs & Services > Credentials. Authorized JavaScript origin phai khop
# http://localhost:5173. Day la gia tri public (khong phai secret) - an toan khi nam trong
# FE build. Phai trung GOOGLE_CLIENT_ID ben task-connect-be/.env.
VITE_GOOGLE_CLIENT_ID=

# Xac minh so dien thoai qua Firebase Phone Auth (dung tinh nang "Phone numbers for testing"
# cua Firebase de demo - khong gui SMS that). Lay tai Firebase Console > Project Settings >
# General > Your apps > Web app. Gia tri public (khong phai secret), an toan trong FE build.
# VITE_FIREBASE_PROJECT_ID phai trung FIREBASE_PROJECT_ID ben task-connect-be/.env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
